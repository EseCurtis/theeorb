{
  "swagger": "2.0",
  "info": { "title": "TheeOrb API", "version": "1.0.0", "description": "Private career copilot API" },
  "basePath": "/api/v1",
  "schemes": ["http"],
  "host": "localhost:4000",
  "tags": [
    { "name": "Authentication", "description": "Account access" },
    { "name": "Career", "description": "Career profile and private CV documents" },
    { "name": "Applications", "description": "Job extraction, drafts, and explicit sends" },
    { "name": "Gmail", "description": "Gmail OAuth connection" },
    { "name": "Orb", "description": "Private career copilot configuration" }
  ],
  "paths": {
    "/auth/sign-up": { "post": { "tags": ["Authentication"], "summary": "Create an account without disclosing account state", "responses": { "202": { "description": "Accepted", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/auth/sign-in": { "post": { "tags": ["Authentication"], "summary": "Sign in", "responses": { "200": { "description": "Signed in", "schema": { "$ref": "#/definitions/Response" } }, "401": { "description": "Invalid credentials", "schema": { "$ref": "#/definitions/Error" } } } } },
    "/auth/password-recovery": { "post": { "tags": ["Authentication"], "summary": "Request password recovery without disclosing account state", "responses": { "200": { "description": "Accepted", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/auth/password-reset": { "post": { "tags": ["Authentication"], "summary": "Reset a password with a valid recovery token", "responses": { "200": { "description": "Password reset", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/auth/session": { "get": { "tags": ["Authentication"], "summary": "Read current account", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Session", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/auth/sign-out": { "post": { "tags": ["Authentication"], "summary": "Sign out", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Signed out", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/orb": { "get": { "tags": ["Orb"], "summary": "Read career Orb", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Orb", "schema": { "$ref": "#/definitions/Response" } } } }, "post": { "tags": ["Orb"], "summary": "Create career Orb", "security": [{ "Bearer": [] }], "responses": { "201": { "description": "Created", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/orb/nursery": { "get": { "tags": ["Orb"], "summary": "Read private career Orb Nursery", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Nursery", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/orb/nursery/teach": { "post": { "tags": ["Orb"], "summary": "Teach career Orb privately", "security": [{ "Bearer": [] }], "responses": { "201": { "description": "Lesson", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/orb/nursery/rules": { "put": { "tags": ["Orb"], "summary": "Update career-Orb boundaries", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Saved", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/career/profile": { "get": { "tags": ["Career"], "summary": "Read private career profile", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Profile", "schema": { "$ref": "#/definitions/Response" } } } }, "put": { "tags": ["Career"], "summary": "Save structured career profile", "security": [{ "Bearer": [] }], "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CareerProfileRequest" } }], "responses": { "200": { "description": "Saved", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/career/documents": { "get": { "tags": ["Career"], "summary": "List owned CV documents", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Documents", "schema": { "$ref": "#/definitions/Response" } } } }, "post": { "tags": ["Career"], "summary": "Save an authenticated Cloudinary CV upload", "security": [{ "Bearer": [] }], "responses": { "201": { "description": "Saved", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/career/documents/signature": { "post": { "tags": ["Career"], "summary": "Create signed CV upload", "security": [{ "Bearer": [] }], "responses": { "201": { "description": "Signature", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/job-listings/extract": { "post": { "tags": ["Applications"], "summary": "Extract a pasted job listing", "security": [{ "Bearer": [] }], "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/JobListingRequest" } }], "responses": { "201": { "description": "Extracted", "schema": { "$ref": "#/definitions/Response" } }, "503": { "description": "AI unavailable", "schema": { "$ref": "#/definitions/Error" } } } } },
    "/job-listings/{jobListingId}": { "put": { "tags": ["Applications"], "summary": "Review extracted job details", "security": [{ "Bearer": [] }], "parameters": [{ "in": "path", "name": "jobListingId", "required": true, "type": "string" }], "responses": { "200": { "description": "Reviewed", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/applications": { "get": { "tags": ["Applications"], "summary": "List owned application tracker records", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Applications", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/applications/drafts": { "post": { "tags": ["Applications"], "summary": "Create concise cover-letter draft", "security": [{ "Bearer": [] }], "responses": { "201": { "description": "Draft", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/applications/{applicationId}": { "put": { "tags": ["Applications"], "summary": "Review and save an application", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Saved", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/applications/{applicationId}/send": { "post": { "tags": ["Applications"], "summary": "Explicitly send a reviewed application with Gmail", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Sent", "schema": { "$ref": "#/definitions/Response" } }, "409": { "description": "Review or Gmail connection required", "schema": { "$ref": "#/definitions/Error" } } } } },
    "/integrations/gmail/connect": { "get": { "tags": ["Gmail"], "summary": "Create Gmail OAuth URL", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "OAuth URL", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/integrations/gmail/callback": { "get": { "tags": ["Gmail"], "summary": "Complete Gmail OAuth", "responses": { "200": { "description": "Connected", "schema": { "$ref": "#/definitions/Response" } } } } },
    "/integrations/gmail": { "get": { "tags": ["Gmail"], "summary": "Read Gmail connection", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Connection", "schema": { "$ref": "#/definitions/Response" } } } }, "delete": { "tags": ["Gmail"], "summary": "Disconnect Gmail", "security": [{ "Bearer": [] }], "responses": { "200": { "description": "Disconnected", "schema": { "$ref": "#/definitions/Response" } } } } }
  },
  "securityDefinitions": { "Bearer": { "type": "apiKey", "name": "Authorization", "in": "header" } },
  "definitions": { "CareerProfileRequest": { "type": "object", "required": ["fullName", "headline", "summary", "skills", "experience", "education", "links"], "properties": { "fullName": { "type": "string" }, "headline": { "type": "string" }, "summary": { "type": "string" }, "skills": { "type": "array", "items": { "type": "string" } }, "experience": { "type": "array" }, "education": { "type": "array" }, "links": { "type": "object" } } }, "JobListingRequest": { "type": "object", "required": ["rawText"], "properties": { "rawText": { "type": "string" } } }, "Response": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "object" }, "data": { "type": "object" } } }, "Error": { "type": "object", "properties": { "success": { "type": "boolean", "example": false }, "message": { "type": "object" }, "data": { "type": "object" } } } }
}
