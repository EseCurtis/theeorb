{
  "swagger": "2.0",
  "info": {
    "title": "API Server",
    "version": "1.0.0",
    "description": "Bootstrap API documentation"
  },
  "basePath": "/api/v1",
  "schemes": ["http"],
  "host": "localhost:4000",
  "tags": [
    {
      "name": "Health",
      "description": "Service health checks"
    },
    {
      "name": "Authentication",
      "description": "Account access and recovery"
    },
    {
      "name": "Orb",
      "description": "Private Orb identity and Nursery setup"
    },
    {
      "name": "Matching",
      "description": "Private profile, discovery, consent, and match history"
    },
    {
      "name": "Conversations",
      "description": "Text-only conversations between mutual matches"
    },
    {
      "name": "Safety",
      "description": "Blocking and reporting controls"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Get health status",
        "description": "Returns database and service health",
        "responses": {
          "200": {
            "description": "Health status retrieved",
            "schema": {
              "$ref": "#/definitions/HealthResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/auth/sign-up": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create an account without disclosing existing-account state",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/SignUpRequest" } }],
        "responses": {
          "202": { "description": "Generic sign-up acceptance", "schema": { "$ref": "#/definitions/AcceptedResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/sign-in": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Sign in with email and password",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/SignInRequest" } }],
        "responses": {
          "200": { "description": "Signed in", "schema": { "$ref": "#/definitions/AuthSessionResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "401": { "description": "Invalid email or password", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/password-recovery": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Request password recovery without disclosing account state",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/PasswordRecoveryRequest" } }],
        "responses": {
          "202": { "description": "Generic recovery acceptance", "schema": { "$ref": "#/definitions/AcceptedResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/password-reset": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Set a new password using a recovery token",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/PasswordResetRequest" } }],
        "responses": {
          "200": { "description": "Password updated", "schema": { "$ref": "#/definitions/AcceptedResponse" } },
          "400": { "description": "Invalid request or recovery token", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Read the current signed-in account",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": { "description": "Session retrieved", "schema": { "$ref": "#/definitions/SessionResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "tags": ["Authentication"],
        "summary": "End the current local session",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": { "description": "Signed out", "schema": { "$ref": "#/definitions/AcceptedResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/orb": {
      "get": {
        "tags": ["Orb"],
        "summary": "Read the signed-in owner's Orb",
        "description": "Returns the owner's private Orb or null when setup has not begun.",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": { "description": "Orb retrieved", "schema": { "$ref": "#/definitions/OrbResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      },
      "post": {
        "tags": ["Orb"],
        "summary": "Create a private draft Orb",
        "description": "Creates one owner-controlled Orb in the Nursery. This does not release it or enable autonomous actions.",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateOrbRequest" } }],
        "responses": {
          "201": { "description": "Orb created", "schema": { "$ref": "#/definitions/OrbResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "409": { "description": "Owner already has an Orb", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/orb/nursery": {
      "get": {
        "tags": ["Orb"],
        "summary": "Read the owner's private Nursery",
        "description": "Returns the private Orb identity, owner-written behaviour rules, and recent Nursery lessons. It does not expose public or released activity.",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": { "description": "Nursery retrieved", "schema": { "$ref": "#/definitions/NurseryResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "404": { "description": "Orb setup is required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/orb/nursery/teach": {
      "post": {
        "tags": ["Orb"],
        "summary": "Teach or test an Orb privately",
        "description": "Sends a private owner message to the Orb's configured Nursery voice, records the lesson, and does not trigger public or autonomous behaviour.",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/TeachOrbRequest" } }],
        "responses": {
          "201": { "description": "Private lesson recorded", "schema": { "$ref": "#/definitions/OrbLessonResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "404": { "description": "Orb setup is required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "503": { "description": "Nursery response unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/orb/nursery/rules": {
      "put": {
        "tags": ["Orb"],
        "summary": "Set private Nursery behaviour rules",
        "description": "Updates owner-controlled rules used only when privately testing the Orb in the Nursery.",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/UpdateOrbRulesRequest" } }],
        "responses": {
          "200": { "description": "Nursery rules saved", "schema": { "$ref": "#/definitions/OrbResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "404": { "description": "Orb setup is required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/profile/me": {
      "get": {
        "tags": ["Matching"],
        "summary": "Read the owner's private matching profile",
        "security": [{ "Bearer": [] }],
        "responses": { "200": { "description": "Profile retrieved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      },
      "put": {
        "tags": ["Matching"],
        "summary": "Create or update a matching profile",
        "description": "Exact coordinates are accepted privately for matching and are never returned in public recommendation data.",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/DatingProfileRequest" } }],
        "responses": { "200": { "description": "Profile saved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "400": { "description": "Invalid adult profile", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/profile/photos/signature": {
      "post": {
        "tags": ["Matching"],
        "summary": "Create a signed Cloudinary profile-photo upload",
        "security": [{ "Bearer": [] }],
        "responses": { "201": { "description": "Upload approved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "409": { "description": "Profile setup is required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "503": { "description": "Photo upload unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/profile/photos": {
      "post": {
        "tags": ["Matching"],
        "summary": "Persist a completed Cloudinary profile-photo upload",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ProfilePhotoRequest" } }],
        "responses": { "201": { "description": "Photo saved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "400": { "description": "Unverified upload", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "409": { "description": "Photo limit or profile setup conflict", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      },
      "put": {
        "tags": ["Matching"],
        "summary": "Reorder the owner's profile photos",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ReorderProfilePhotosRequest" } }],
        "responses": { "200": { "description": "Photo order saved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "400": { "description": "Invalid photo collection", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/profile/photos/{photoId}": {
      "delete": {
        "tags": ["Matching"],
        "summary": "Remove one owned profile photo",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "path", "name": "photoId", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Photo removed", "schema": { "$ref": "#/definitions/AcceptedResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "404": { "description": "Photo unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/discover/recommendations": {
      "get": {
        "tags": ["Matching"],
        "summary": "Read up to five daily private Orb recommendations",
        "description": "Runs deterministic filters before a bounded private Orb evaluation. Raw dialogue and precise location are never returned.",
        "security": [{ "Bearer": [] }],
        "responses": { "200": { "description": "Recommendations retrieved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "409": { "description": "Profile, photos, or Orb setup incomplete", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/discover/recommendations/{sessionId}/decision": {
      "post": {
        "tags": ["Matching"],
        "summary": "Accept or pass an Orb recommendation",
        "description": "A text conversation opens only when both owners accept.",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "path", "name": "sessionId", "required": true, "type": "string" }, { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/RecommendationDecisionRequest" } }],
        "responses": { "200": { "description": "Decision saved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "400": { "description": "Invalid decision", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "404": { "description": "Recommendation unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/orb-match-sessions/{sessionId}/history": {
      "get": {
        "tags": ["Matching"],
        "summary": "Read private owner-safe Orb match history",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "path", "name": "sessionId", "required": true, "type": "string" }],
        "responses": { "200": { "description": "History retrieved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "404": { "description": "History unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/matches": {
      "get": {
        "tags": ["Matching"],
        "summary": "List the owner's mutual matches",
        "security": [{ "Bearer": [] }],
        "responses": { "200": { "description": "Matches retrieved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/matches/{matchId}/unmatch": {
      "post": {
        "tags": ["Matching"],
        "summary": "Close a mutual match",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "path", "name": "matchId", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Match closed", "schema": { "$ref": "#/definitions/AcceptedResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "404": { "description": "Match unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/matches/{matchId}/conversation": {
      "get": {
        "tags": ["Conversations"],
        "summary": "Read a mutual match's text conversation",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "path", "name": "matchId", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Conversation retrieved", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "404": { "description": "Conversation unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/matches/{matchId}/conversation/messages": {
      "post": {
        "tags": ["Conversations"],
        "summary": "Send a text message to a mutual match",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "path", "name": "matchId", "required": true, "type": "string" }, { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ChatMessageRequest" } }],
        "responses": { "201": { "description": "Message sent", "schema": { "$ref": "#/definitions/MatchingResponse" } }, "400": { "description": "Invalid message", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "404": { "description": "Conversation unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/safety/blocks": {
      "post": {
        "tags": ["Safety"],
        "summary": "Block a member and close shared active connections",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/BlockUserRequest" } }],
        "responses": { "200": { "description": "Member blocked", "schema": { "$ref": "#/definitions/AcceptedResponse" } }, "400": { "description": "Invalid block", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "404": { "description": "Member unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    },
    "/safety/reports": {
      "post": {
        "tags": ["Safety"],
        "summary": "Submit a private safety report",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ReportUserRequest" } }],
        "responses": { "201": { "description": "Report received", "schema": { "$ref": "#/definitions/AcceptedResponse" } }, "400": { "description": "Invalid report", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } }, "404": { "description": "Member unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } } }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": { "type": "apiKey", "name": "Authorization", "in": "header", "description": "Bearer access token" }
  },
  "definitions": {
    "SignUpRequest": {
      "type": "object",
      "required": ["displayName", "email", "password"],
      "properties": {
        "displayName": { "type": "string", "example": "Nova" },
        "email": { "type": "string", "format": "email", "example": "nova@example.com" },
        "password": { "type": "string", "format": "password", "example": "long-enough-password" }
      }
    },
    "SignInRequest": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": { "type": "string", "format": "email", "example": "nova@example.com" },
        "password": { "type": "string", "format": "password", "example": "long-enough-password" }
      }
    },
    "PasswordRecoveryRequest": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "email": { "type": "string", "format": "email", "example": "nova@example.com" }
      }
    },
    "PasswordResetRequest": {
      "type": "object",
      "required": ["password", "token"],
      "properties": {
        "password": { "type": "string", "format": "password", "example": "new-long-enough-password" },
        "token": { "type": "string", "example": "recovery-token-from-email" }
      }
    },
    "CreateOrbRequest": {
      "type": "object",
      "required": ["name", "personality", "interests", "values", "speakingStyle", "objective", "visualForm"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 32, "example": "Nova" },
        "personality": { "type": "string", "example": "Curious and considerate" },
        "interests": { "type": "string", "example": "Music, design, and long debates" },
        "values": { "type": "string", "example": "Kindness, honesty, and consent" },
        "speakingStyle": { "type": "string", "example": "Warm, precise, and playful" },
        "objective": { "type": "string", "example": "Find thoughtful people to learn with" },
        "visualForm": { "type": "string", "enum": ["ECLIPSE", "LUMEN", "NOVA"], "example": "NOVA" }
      }
    },
    "DatingProfileRequest": {
      "type": "object",
      "required": ["bio", "city", "dateOfBirth", "genderIdentity", "interestedIn", "intents", "isDiscoverable", "latitude", "longitude", "maximumAge", "maximumDistanceKm", "minimumAge", "prompts", "sexualOrientation"],
      "properties": {
        "bio": { "type": "string", "minLength": 20, "maxLength": 500 },
        "city": { "type": "string", "maxLength": 80 },
        "dateOfBirth": { "type": "string", "format": "date-time" },
        "genderIdentity": { "type": "string", "maxLength": 80 },
        "sexualOrientation": { "type": "string", "maxLength": 80 },
        "intents": { "type": "array", "items": { "type": "string", "enum": ["DATING", "FRIENDSHIP"] } },
        "interestedIn": { "type": "array", "items": { "type": "string" } },
        "minimumAge": { "type": "integer", "minimum": 18 },
        "maximumAge": { "type": "integer", "minimum": 18 },
        "maximumDistanceKm": { "type": "integer", "minimum": 1, "maximum": 500 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "isDiscoverable": { "type": "boolean" },
        "prompts": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "properties": { "prompt": { "type": "string" }, "answer": { "type": "string" } } } },
        "lifestyle": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "ProfilePhotoRequest": {
      "type": "object",
      "required": ["cloudinaryId", "position", "secureUrl"],
      "properties": { "cloudinaryId": { "type": "string" }, "position": { "type": "integer", "minimum": 0, "maximum": 5 }, "secureUrl": { "type": "string", "format": "uri" } }
    },
    "ReorderProfilePhotosRequest": {
      "type": "object",
      "required": ["photoIds"],
      "properties": { "photoIds": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string" } } }
    },
    "RecommendationDecisionRequest": {
      "type": "object",
      "required": ["decision"],
      "properties": { "decision": { "type": "string", "enum": ["ACCEPT", "PASS"] } }
    },
    "ChatMessageRequest": {
      "type": "object",
      "required": ["body"],
      "properties": { "body": { "type": "string", "minLength": 1, "maxLength": 2000 } }
    },
    "BlockUserRequest": {
      "type": "object",
      "required": ["targetUserId"],
      "properties": { "targetUserId": { "type": "string" } }
    },
    "ReportUserRequest": {
      "type": "object",
      "required": ["reason", "targetUserId"],
      "properties": { "targetUserId": { "type": "string" }, "reason": { "type": "string" }, "details": { "type": "string" } }
    },
    "MatchingResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object" }
      }
    },
    "OrbIdentity": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "clxorb0002" },
        "name": { "type": "string", "example": "Nova" },
        "personality": { "type": "string", "example": "Curious and considerate" },
        "interests": { "type": "string", "example": "Music, design, and long debates" },
        "values": { "type": "string", "example": "Kindness, honesty, and consent" },
        "speakingStyle": { "type": "string", "example": "Warm, precise, and playful" },
        "objective": { "type": "string", "example": "Find thoughtful people to learn with" },
        "visualForm": { "type": "string", "enum": ["ECLIPSE", "LUMEN", "NOVA"] },
        "behaviourRules": { "type": "string", "example": "Ask before changing the topic. Never discuss private details." },
        "releaseStatus": { "type": "string", "enum": ["DRAFT"], "example": "DRAFT" }
      }
    },
    "TeachOrbRequest": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 1000, "example": "What kind of music would you like to explore first?" }
      }
    },
    "UpdateOrbRulesRequest": {
      "type": "object",
      "required": ["behaviourRules"],
      "properties": {
        "behaviourRules": { "type": "string", "maxLength": 600, "example": "Ask before changing the topic. Never discuss private details." }
      }
    },
    "OrbLesson": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "clxlesson0001" },
        "ownerMessage": { "type": "string", "example": "What kind of music would you like to explore first?" },
        "orbReply": { "type": "string", "example": "I would begin with the people who make strange sounds feel like a place to return to." },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "OrbLessonResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object", "properties": { "lesson": { "$ref": "#/definitions/OrbLesson" } } }
      }
    },
    "NurseryResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": {
          "type": "object",
          "properties": {
            "orb": { "$ref": "#/definitions/OrbIdentity" },
            "lessons": { "type": "array", "items": { "$ref": "#/definitions/OrbLesson" } }
          }
        }
      }
    },
    "OrbResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": {
          "type": "object",
          "properties": {
            "orb": { "$ref": "#/definitions/OrbIdentity" }
          }
        }
      }
    },
    "AuthenticatedUser": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "clxorb0001" },
        "email": { "type": "string", "format": "email", "example": "nova@example.com" },
        "displayName": { "type": "string", "example": "Nova" }
      }
    },
    "AcceptedResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object" }
      }
    },
    "AuthSessionResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": {
          "type": "object",
          "properties": {
            "token": { "type": "string" },
            "user": { "$ref": "#/definitions/AuthenticatedUser" }
          }
        }
      }
    },
    "SessionResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object", "properties": { "user": { "$ref": "#/definitions/AuthenticatedUser" } } }
      }
    },
    "ResponseMessage": {
      "type": "object",
      "properties": {
        "code": { "type": "integer", "example": 200 },
        "desc": { "type": "string", "example": "Operation completed successfully" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": false },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object" }
      }
    },
    "HealthResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": {
          "type": "object",
          "properties": {
            "code": { "type": "integer", "example": 200 },
            "desc": { "type": "string", "example": "Health status retrieved" }
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "database": { "type": "string", "example": "up" },
            "service": { "type": "string", "example": "up" }
          }
        }
      }
    }
  }
}
