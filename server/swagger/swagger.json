{
  "swagger": "2.0",
  "info": {
    "title": "API Server",
    "version": "1.0.0",
    "description": "Bootstrap API documentation"
  },
  "basePath": "/api/v1",
  "schemes": ["http"],
  "host": "localhost:4000",
  "tags": [
    {
      "name": "Health",
      "description": "Service health checks"
    },
    {
      "name": "Authentication",
      "description": "Account access and recovery"
    },
    {
      "name": "Orb",
      "description": "Private Orb identity and Nursery setup"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Get health status",
        "description": "Returns database and service health",
        "responses": {
          "200": {
            "description": "Health status retrieved",
            "schema": {
              "$ref": "#/definitions/HealthResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/auth/sign-up": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create an account without disclosing existing-account state",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/SignUpRequest" } }],
        "responses": {
          "202": { "description": "Generic sign-up acceptance", "schema": { "$ref": "#/definitions/AcceptedResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/sign-in": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Sign in with email and password",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/SignInRequest" } }],
        "responses": {
          "200": { "description": "Signed in", "schema": { "$ref": "#/definitions/AuthSessionResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "401": { "description": "Invalid email or password", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/password-recovery": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Request password recovery without disclosing account state",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/PasswordRecoveryRequest" } }],
        "responses": {
          "202": { "description": "Generic recovery acceptance", "schema": { "$ref": "#/definitions/AcceptedResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/password-reset": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Set a new password using a recovery token",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/PasswordResetRequest" } }],
        "responses": {
          "200": { "description": "Password updated", "schema": { "$ref": "#/definitions/AcceptedResponse" } },
          "400": { "description": "Invalid request or recovery token", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Read the current signed-in account",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": { "description": "Session retrieved", "schema": { "$ref": "#/definitions/SessionResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "tags": ["Authentication"],
        "summary": "End the current local session",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": { "description": "Signed out", "schema": { "$ref": "#/definitions/AcceptedResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/orb": {
      "get": {
        "tags": ["Orb"],
        "summary": "Read the signed-in owner's Orb",
        "description": "Returns the owner's private Orb or null when setup has not begun.",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": { "description": "Orb retrieved", "schema": { "$ref": "#/definitions/OrbResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      },
      "post": {
        "tags": ["Orb"],
        "summary": "Create a private draft Orb",
        "description": "Creates one owner-controlled Orb in the Nursery. This does not release it or enable autonomous actions.",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateOrbRequest" } }],
        "responses": {
          "201": { "description": "Orb created", "schema": { "$ref": "#/definitions/OrbResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "409": { "description": "Owner already has an Orb", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/orb/nursery": {
      "get": {
        "tags": ["Orb"],
        "summary": "Read the owner's private Nursery",
        "description": "Returns the private Orb identity, owner-written behaviour rules, and recent Nursery lessons. It does not expose public or released activity.",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": { "description": "Nursery retrieved", "schema": { "$ref": "#/definitions/NurseryResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "404": { "description": "Orb setup is required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/orb/nursery/teach": {
      "post": {
        "tags": ["Orb"],
        "summary": "Teach or test an Orb privately",
        "description": "Sends a private owner message to the Orb's configured Nursery voice, records the lesson, and does not trigger public or autonomous behaviour.",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/TeachOrbRequest" } }],
        "responses": {
          "201": { "description": "Private lesson recorded", "schema": { "$ref": "#/definitions/OrbLessonResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "404": { "description": "Orb setup is required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "503": { "description": "Nursery response unavailable", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    },
    "/orb/nursery/rules": {
      "put": {
        "tags": ["Orb"],
        "summary": "Set private Nursery behaviour rules",
        "description": "Updates owner-controlled rules used only when privately testing the Orb in the Nursery.",
        "security": [{ "Bearer": [] }],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/UpdateOrbRulesRequest" } }],
        "responses": {
          "200": { "description": "Nursery rules saved", "schema": { "$ref": "#/definitions/OrbResponse" } },
          "400": { "description": "Invalid request", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "401": { "description": "Authentication required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "404": { "description": "Orb setup is required", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/ErrorResponse" } }
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": { "type": "apiKey", "name": "Authorization", "in": "header", "description": "Bearer access token" }
  },
  "definitions": {
    "SignUpRequest": {
      "type": "object",
      "required": ["displayName", "email", "password"],
      "properties": {
        "displayName": { "type": "string", "example": "Nova" },
        "email": { "type": "string", "format": "email", "example": "nova@example.com" },
        "password": { "type": "string", "format": "password", "example": "long-enough-password" }
      }
    },
    "SignInRequest": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": { "type": "string", "format": "email", "example": "nova@example.com" },
        "password": { "type": "string", "format": "password", "example": "long-enough-password" }
      }
    },
    "PasswordRecoveryRequest": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "email": { "type": "string", "format": "email", "example": "nova@example.com" }
      }
    },
    "PasswordResetRequest": {
      "type": "object",
      "required": ["password", "token"],
      "properties": {
        "password": { "type": "string", "format": "password", "example": "new-long-enough-password" },
        "token": { "type": "string", "example": "recovery-token-from-email" }
      }
    },
    "CreateOrbRequest": {
      "type": "object",
      "required": ["name", "personality", "interests", "values", "speakingStyle", "objective", "visualForm"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 32, "example": "Nova" },
        "personality": { "type": "string", "example": "Curious and considerate" },
        "interests": { "type": "string", "example": "Music, design, and long debates" },
        "values": { "type": "string", "example": "Kindness, honesty, and consent" },
        "speakingStyle": { "type": "string", "example": "Warm, precise, and playful" },
        "objective": { "type": "string", "example": "Find thoughtful people to learn with" },
        "visualForm": { "type": "string", "enum": ["ECLIPSE", "LUMEN", "NOVA"], "example": "NOVA" }
      }
    },
    "OrbIdentity": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "clxorb0002" },
        "name": { "type": "string", "example": "Nova" },
        "personality": { "type": "string", "example": "Curious and considerate" },
        "interests": { "type": "string", "example": "Music, design, and long debates" },
        "values": { "type": "string", "example": "Kindness, honesty, and consent" },
        "speakingStyle": { "type": "string", "example": "Warm, precise, and playful" },
        "objective": { "type": "string", "example": "Find thoughtful people to learn with" },
        "visualForm": { "type": "string", "enum": ["ECLIPSE", "LUMEN", "NOVA"] },
        "behaviourRules": { "type": "string", "example": "Ask before changing the topic. Never discuss private details." },
        "releaseStatus": { "type": "string", "enum": ["DRAFT"], "example": "DRAFT" }
      }
    },
    "TeachOrbRequest": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 1000, "example": "What kind of music would you like to explore first?" }
      }
    },
    "UpdateOrbRulesRequest": {
      "type": "object",
      "required": ["behaviourRules"],
      "properties": {
        "behaviourRules": { "type": "string", "maxLength": 600, "example": "Ask before changing the topic. Never discuss private details." }
      }
    },
    "OrbLesson": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "clxlesson0001" },
        "ownerMessage": { "type": "string", "example": "What kind of music would you like to explore first?" },
        "orbReply": { "type": "string", "example": "I would begin with the people who make strange sounds feel like a place to return to." },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "OrbLessonResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object", "properties": { "lesson": { "$ref": "#/definitions/OrbLesson" } } }
      }
    },
    "NurseryResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": {
          "type": "object",
          "properties": {
            "orb": { "$ref": "#/definitions/OrbIdentity" },
            "lessons": { "type": "array", "items": { "$ref": "#/definitions/OrbLesson" } }
          }
        }
      }
    },
    "OrbResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": {
          "type": "object",
          "properties": {
            "orb": { "$ref": "#/definitions/OrbIdentity" }
          }
        }
      }
    },
    "AuthenticatedUser": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "clxorb0001" },
        "email": { "type": "string", "format": "email", "example": "nova@example.com" },
        "displayName": { "type": "string", "example": "Nova" }
      }
    },
    "AcceptedResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object" }
      }
    },
    "AuthSessionResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": {
          "type": "object",
          "properties": {
            "token": { "type": "string" },
            "user": { "$ref": "#/definitions/AuthenticatedUser" }
          }
        }
      }
    },
    "SessionResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object", "properties": { "user": { "$ref": "#/definitions/AuthenticatedUser" } } }
      }
    },
    "ResponseMessage": {
      "type": "object",
      "properties": {
        "code": { "type": "integer", "example": 200 },
        "desc": { "type": "string", "example": "Operation completed successfully" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": false },
        "message": { "$ref": "#/definitions/ResponseMessage" },
        "data": { "type": "object" }
      }
    },
    "HealthResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "message": {
          "type": "object",
          "properties": {
            "code": { "type": "integer", "example": 200 },
            "desc": { "type": "string", "example": "Health status retrieved" }
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "database": { "type": "string", "example": "up" },
            "service": { "type": "string", "example": "up" }
          }
        }
      }
    }
  }
}
